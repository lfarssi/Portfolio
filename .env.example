# Public base URL of the deployed site, no trailing slash (e.g. https://example.com)
NEXT_PUBLIC_SITE_URL=
# EmailJS service ID (Email Services tab). Server-only: used by the contact server action
EMAILJS_SERVICE_ID=
# EmailJS template ID (Email Templates tab). Server-only
EMAILJS_TEMPLATE_ID=
# EmailJS public key (Account > General). Server-only
EMAILJS_PUBLIC_KEY=
# EmailJS private key (Account > General). Server-only, enables the REST API from the server
EMAILJS_PRIVATE_KEY=
